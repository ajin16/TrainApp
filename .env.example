# =====================================================================
# IRCTC Train Booking Application - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit the '.env' file containing your real credentials to Git!

# Flask Application Settings
SECRET_KEY=your-super-secret-key-change-me
FLASK_DEBUG=0
PORT=5000

# MySQL Database Connection Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=TrainApp
MYSQL_SSL_DISABLED=False

# Optional: Full Database Connection URL (e.g., for Render or Postgres/MySQL)
# If provided, this overrides individual MYSQL_* environment variables above.
# Example for MySQL:
# DATABASE_URL=mysql+mysqlconnector://user:password@hostname:port/database?ssl_disabled=False
# Example for SQLite:
# DATABASE_URL=sqlite:///trainapp.db
